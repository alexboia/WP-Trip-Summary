COMPOSE_PROJECT_NAME=wpts-compat-minimum
WPTS_COMPAT_PROFILE=minimum
WPTS_PORT=8083
# Test the declared minimum PHP branch with its maintained patch releases.
WPTS_PHP_BRANCH=8.3
WPTS_WORDPRESS_RUNTIME_IMAGE=wordpress:7.1.4-php8.3-apache
# WordPress calls the 7.0.0 release "7.0" in its archives and version string.
WPTS_WORDPRESS_VERSION=7.0
WPTS_DATABASE_IMAGE=mysql:5.7.44
WPTS_DATABASE_PLATFORM=linux/amd64
