{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "lot.schema.json",
	"title": "WPTS namespace migration lot",
	"type": "object",
	"additionalProperties": false,
	"required": ["lot"],
	"properties": {
		"lot": {
			"type": "object",
			"additionalProperties": false,
			"required": ["pluginVersion", "status", "objective", "classes"],
			"properties": {
				"pluginVersion": {
					"type": "string",
					"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
				},
				"status": {
					"$ref": "#/$defs/status"
				},
				"objective": {
					"type": "string",
					"minLength": 1
				},
				"classes": {
					"type": "array",
					"minItems": 1,
					"maxItems": 10,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/classEntry"
					}
				}
			}
		}
	},
	"$defs": {
		"status": {
			"type": "string",
			"enum": ["pending", "working", "complete"]
		},
		"classEntry": {
			"type": "object",
			"additionalProperties": false,
			"required": ["className", "filePath", "notes"],
			"properties": {
				"className": {
					"type": "string",
					"pattern": "^Abp01_[A-Za-z0-9_]+$"
				},
				"filePath": {
					"type": "string",
					"pattern": "^lib/.+\\.php$"
				},
				"notes": {
					"type": "string"
				}
			}
		}
	}
}
