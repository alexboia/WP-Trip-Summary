#. Plugin Name of the plugin
#: abp01-plugin-main.php
msgid "WP Trip Summary"
msgstr "WP Trip Summary"

#. Plugin URI of the plugin
#: abp01-plugin-main.php
msgid "https://github.com/alexboia/WP-Trip-Summary"
msgstr "https://github.com/alexboia/WP-Trip-Summary"

#. Description of the plugin
#: abp01-plugin-main.php
msgid ""
"Aids a travel blogger to add structured information about his tours (biking, "
"hiking, train travels etc.)"
msgstr ""
"Unterstützt einen Reiseblogger dabei, strukturierte Informationen über seine "
"Touren (Radfahren, Wandern, Bahnreisen usw.) hinzuzufügen."

#. Author of the plugin
#: abp01-plugin-main.php
msgid "Alexandru Boia"
msgstr "Alexandru Boia"

